# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (default: 3005)
PORT=3005

# Optional: Firebase Authentication (enforces token verification on backend)
FIREBASE_PROJECT_ID=your_firebase_project_id_here
# Optional: Path or raw JSON string for full Firebase Admin service account credentials
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Optional: Allowed CORS origins separated by commas
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
